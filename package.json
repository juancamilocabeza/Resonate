{
  "name": "resonate-player",
  "version": "1.0.0",
  "description": "A free music player for Archive.org content with social media sharing support",
  "homepage": "https://www.resonateplayer.com",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:install": "playwright install",
    "test:smoke": "node tests/smoke.mjs"
  },
  "keywords": [
    "music",
    "player",
    "archive.org",
    "pwa",
    "offline"
  ],
  "author": "Juan Cabeza",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0"
  }
}
